# Copy to .env and fill in. Never commit .env.
# Optional: enables the AI narrative, portfolio analysis and chat agent (NVIDIA NIM, build.nvidia.com).
NVIDIA_API_KEY=

# Optional: input files (defaults: the fictional files in sample_data/).
PORTFOLIO_CSV=
CASH_CSV=
WATCHLIST_CSV=
LEDGER_CSV=

# Optional: Portfolio Lab configuration folder (default: config/lab) and switch.
LAB_CONFIG_DIR=
PORTFOLIO_LAB=
